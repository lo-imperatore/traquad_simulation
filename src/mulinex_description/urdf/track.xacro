<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="track">

  <!-- ===================== ARGOMENTI COMUNI ===================== -->
  <!-- Track model: the ground wheels (1-3) carry 8 passive rollers each (omni-wheel like: grip along the track, roll
       sideways against damping and dry friction), the raised idler (wheel 4) is a plain cylinder; all 4 wheels are
       driven. The track body collides as a box. Earlier variants (cylinders with mimic joints, sphere pairs, gimbal,
       barrel rollers, other roller sizes) were removed on 2026-10-27: see the git history -->

  <!-- whole track (body + 4 wheels + rollers) = 1.0 kg x track_mass_scale = 0.325 kg (real robot);
       masses and inertias of body, wheels and rollers are scaled by the same factor -->
  <xacro:property name="track_mass_scale" default="0.325"/>
  <xacro:property name="wheel_mass" default="${0.1 * track_mass_scale}"/>
  <xacro:property name="wheel_ixx" default="${2.26562e-05 * track_mass_scale}"/>
  <xacro:property name="wheel_iyy" default="${2.26562e-05 * track_mass_scale}"/>
  <xacro:property name="wheel_izz" default="${1.15625e-05 * track_mass_scale}"/>
  <xacro:property name="wheel_mesh" default="file://$(find mulinex_description)/meshes//wheel.stl"/>

  <!-- Wheel/roller contact. Isotropic friction (Isaac Sim default 0.5), lateral compliance
       comes from passive rollers on the ground wheels: roller_damping tunes lateral resistance -->
  <!-- wheel/roller - ground friction (DART uses the lower mu of the two surfaces). IsaacLab locomotion: terrain
       mu 1.0 with "multiply", robot mu randomized 0.4-1.1 (ground_friction event), so the training mean is ~0.75 -->
  <xacro:property name="wheel_mu" value="${float($(arg wheel_mu))}"/>
  <!-- roller_n / roller_radius / wheel_effort are xacro args of traquad.xacro (IsaacLab policies are trained
       with 3 rollers of 14 mm and a 0.694 N m wheel drive: see gz_traquad_policy.launch.py).
       The roller centre moves so that the roller reaches the wheel radius (15 mm); the rollers of a wheel
       weigh the same whatever their number (as in flatten_traquad_usd.py) -->
  <xacro:property name="wheel_radius" value="0.015"/>
  <xacro:property name="roller_n" value="${int($(arg roller_n))}"/>
  <xacro:property name="roller_radius" value="${float($(arg roller_radius))}"/>
  <xacro:property name="roller_ring_radius" value="${wheel_radius - roller_radius}"/>
  <xacro:property name="roller_mass" value="${0.04 * track_mass_scale / roller_n}"/>
  <!-- dry friction of the roller joints [N m]: in the IsaacLab asset 0.1 for 8 mm rollers, scaled with the radius
       (0.175 for 14 mm, same lateral break-away force); it sets how easily the tracks slide sideways (skid steering) -->
  <xacro:property name="roller_friction" value="${float($(arg roller_friction))}"/>
  <!-- torque limit of the wheel drives: the velocity command of gz_ros2_control is a servo capped at this value -->
  <xacro:property name="wheel_effort" value="${float($(arg wheel_effort))}"/>
  <!-- track body colliders of the IsaacLab nose asset (Legs3+ policies) instead of the body mesh -->
  <xacro:property name="idler_sphere" value="${'$(arg idler_sphere)'.lower() in ('true', '1')}"/>
  <xacro:property name="track_nose" value="${'$(arg track_nose)'.lower() in ('true', '1')}"/>
  <!-- bounding-box colliders of the track body (Isaac Sim asset) instead of the body mesh, when track_nose is off -->
  <xacro:property name="body_box" value="${'$(arg body_box)'.lower() in ('true', '1')}"/>
  <xacro:property name="roller_damping" value="1e-4"/>
  <!-- roller rotational inertia (armature-like, larger than the physical 1.3e-7): in DART the
       effective joint damping is capped at about inertia/timestep -->
  <xacro:property name="roller_inertia" value="1e-5"/>

  <xacro:property name="body_mass" value="${0.6 * track_mass_scale}"/>
  <!-- Passive ankle (xacro args of traquad.xacro). Defaults - range centred on the pose where the track lies flat
       (wheels 1-3 level) with HFE at +-1.13 rad. IsaacLab asset (policies, HFE +-1.47) - centre 0.1009, range 0.5236
       (front -24.2 .. +35.8 deg, hind mirrored), damping 0.01 (ankles actuator) -->
  <xacro:property name="ankle_flat" value="${float($(arg ankle_center))}"/>
  <xacro:property name="ankle_range" value="${float($(arg ankle_range))}"/>
  <xacro:property name="ankle_damping" value="${float($(arg ankle_damping))}"/>
  <xacro:property name="body_left_mesh" default="file://$(find mulinex_description)/meshes//body_left.stl"/>
  <xacro:property name="body_right_mesh" default="file://$(find mulinex_description)/meshes//body_right.stl"/>
  <!-- visual-only track belt wrapping the four wheels (generated by meshes/make_track_belt.py) -->
  <xacro:property name="track_belt_left_mesh" value="file://$(find mulinex_description)/meshes//track_belt_left.stl"/>
  <xacro:property name="track_belt_right_mesh" value="file://$(find mulinex_description)/meshes//track_belt_right.stl"/>

  <!-- ===================== MACRO ===================== -->

  <xacro:macro name="contact_friction" params="link">
    <gazebo reference="${link}">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>${wheel_mu}</mu>
              <mu2>${wheel_mu}</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <!-- Passive rollers on the wheel rim (wheel link frame, axis z, mid-plane z=-0.0225),
       each roller axis tangent to the rim -->
  <xacro:macro name="roller_ring" params="wheel k">
    <xacro:property name="th" value="${2*pi*k/roller_n}"/>
    <link name="${wheel}_roller_${k}">
      <inertial>
        <mass value="${roller_mass}"/>
        <inertia ixx="${roller_inertia}" ixy="0" ixz="0" iyy="${roller_inertia}" iyz="0" izz="${roller_inertia}"/>
      </inertial>
      <visual>
        <geometry>
          <sphere radius="${roller_radius}"/>
        </geometry>
        <material name="roller_material">
          <color rgba="0.3 0.3 0.3 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${roller_radius}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${wheel}_roller_${k}_joint" type="continuous">
      <origin xyz="${roller_ring_radius*cos(th)} ${roller_ring_radius*sin(th)} -0.0225" rpy="0 0 ${th + pi/2}"/>
      <parent link="${wheel}"/>
      <child link="${wheel}_roller_${k}"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="${roller_damping}" friction="${roller_friction}"/>
    </joint>
    <xacro:contact_friction link="${wheel}_roller_${k}"/>
    <xacro:if value="${k + 1 &lt; roller_n}">
      <xacro:roller_ring wheel="${wheel}" k="${k + 1}"/>
    </xacro:if>
  </xacro:macro>

  <!-- Macro RUOTA: rollers=true for ground wheels, false for the raised idler -->
  <xacro:macro name="wheel" params="name parent xyz rpy rollers:=true">
    <link name="${name}">
      <xacro:if value="${rollers}">
        <xacro:property name="hub_mass" value="${wheel_mass - roller_n*roller_mass}"/>
      </xacro:if>
      <xacro:unless value="${rollers}">
        <xacro:property name="hub_mass" value="${wheel_mass}"/>
      </xacro:unless>
      <inertial>
        <origin xyz="0 0 -0.0225" rpy="0 0 0"/>
        <mass value="${hub_mass}"/>
        <inertia ixx="${wheel_ixx*hub_mass/wheel_mass}" ixy="0" ixz="0"
                 iyy="${wheel_iyy*hub_mass/wheel_mass}" iyz="0" izz="${wheel_izz*hub_mass/wheel_mass}"/>
      </inertial>
      <xacro:unless value="${rollers}">
        <visual>
          <origin xyz="0 0 -0.045" rpy="-1.5708 -1.5708 0"/>
          <geometry>
            <mesh filename="${wheel_mesh}"/>
          </geometry>
          <material name="${name}_material">
            <color rgba="0.615686 0.811765 0.929412 1"/>
          </material>
        </visual>
        <xacro:if value="${idler_sphere}">
          <!-- sphere of the wheel radius: DART handles cylinder-box edge contacts poorly (the idler stalls on step edges) -->
          <collision>
            <origin xyz="0 0 -0.0225" rpy="0 0 0"/>
            <geometry>
              <sphere radius="0.015"/>
            </geometry>
          </collision>
        </xacro:if>
        <xacro:unless value="${idler_sphere}">
          <collision>
            <!-- primitive equivalent of wheel.stl (r=0.015, width=0.045) -->
            <origin xyz="0 0 -0.0225" rpy="0 0 0"/>
            <geometry>
              <cylinder radius="0.015" length="0.045"/>
            </geometry>
          </collision>
        </xacro:unless>
      </xacro:unless>
    </link>

    <joint name="joint_${name}" type="continuous">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${name}"/>
      <axis xyz="0 0 1"/>
      <limit effort="${wheel_effort}" velocity="100000"/>
    </joint>

    <xacro:if value="${rollers}">
      <xacro:roller_ring wheel="${name}" k="0"/>
    </xacro:if>
    <xacro:unless value="${rollers}">
      <xacro:contact_friction link="${name}"/>
    </xacro:unless>
  </xacro:macro>

  <!-- Macro CORPO LEFT -->
  <xacro:macro name="body_left" params="name parent xyz rpy ankle_center">
    <joint name="${name}_ankle" type="revolute">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${name}"/>
      <axis xyz="1 0 0"/>
      <limit effort="10" velocity="10" lower="${ankle_center - ankle_range}" upper="${ankle_center + ankle_range}"/>
      <dynamics damping="${ankle_damping}" friction="0.0"/>
    </joint>

    <link name="${name}">
      <inertial>
        <!-- along the track (y) the CoM is placed so that the whole track (body + 4 wheels) has its CoM straight
             below the ankle axis when the track is flat: a hanging track swings about the flat pose -->
        <origin xyz="0.0238777 0.0132172 -0.00412068" rpy="0 0 0"/>
        <mass value="${body_mass}"/>
        <inertia ixx="${0.000408384 * track_mass_scale}" ixy="${6.93353e-06 * track_mass_scale}" ixz="${3.09979e-05 * track_mass_scale}"
                 iyy="${0.000335218 * track_mass_scale}" iyz="${-2.90084e-05 * track_mass_scale}" izz="${0.000303698 * track_mass_scale}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 3.14159"/>
        <geometry>
          <mesh filename="${body_left_mesh}"/>
        </geometry>
        <material name="${name}_material">
          <color rgba="0.647059 0.647059 0.647059 1"/>
        </material>
      </visual>
      <visual>
        <geometry>
          <mesh filename="${track_belt_left_mesh}"/>
        </geometry>
        <material name="track_belt_material">
          <color rgba="0.13 0.13 0.14 1"/>
        </material>
      </visual>
      <xacro:if value="${body_box and not track_nose}">
        <!-- bounding box of body_left.stl (no convex hull of the mesh on steps and obstacles);
             12.5 mm above the ground when the track lies flat, as the mesh -->
        <collision>
          <origin xyz="0.025 -0.0119 -0.0174" rpy="0 0 0"/>
          <geometry>
            <box size="0.05 0.1417 0.0869"/>
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${not track_nose and not body_box}">
        <collision>
          <origin xyz="0 0 0" rpy="0 0 3.14159"/>
          <geometry>
            <mesh filename="${body_left_mesh}"/>
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${track_nose}">
        <!-- IsaacLab nose asset (Legs3+) - track box cut along the belt line + belt_nose prism (meshes/make_track_nose.py) -->
        <collision name="${name}_box">
          <geometry>
            <mesh filename="file://$(find mulinex_description)/meshes//track_box_nose_left.stl"/>
          </geometry>
        </collision>
        <collision name="${name}_belt_nose">
          <geometry>
            <mesh filename="file://$(find mulinex_description)/meshes//track_belt_nose_left.stl"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <xacro:if value="${track_nose}">
      <!-- frictionless, as in IsaacLab (ground_friction frictionless_colliders) - they stand for the driven belt -->
      <gazebo reference="${name}">
        <collision>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </gazebo>
    </xacro:if>
  </xacro:macro>

  <!-- Macro CORPO RIGHT -->
  <xacro:macro name="body_right" params="name parent xyz rpy ankle_center">
    <joint name="${name}_ankle" type="revolute">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${name}"/>
      <axis xyz="1 0 0"/>
      <limit effort="10" velocity="10" lower="${ankle_center - ankle_range}" upper="${ankle_center + ankle_range}"/>
      <dynamics damping="${ankle_damping}" friction="0.0"/>
    </joint>

    <link name="${name}">
      <inertial>
        <!-- mirror of body_left: along the track (z) CoM below the ankle axis with the track flat -->
        <origin xyz="-0.0238777 0.00412068 0.0132172" rpy="0 0 0"/>
        <mass value="${body_mass}"/>
        <inertia ixx="${0.000408384 * track_mass_scale}" ixy="${3.09979e-05 * track_mass_scale}" ixz="${-6.93353e-06 * track_mass_scale}"
                 iyy="${0.000303698 * track_mass_scale}" iyz="${2.90084e-05 * track_mass_scale}" izz="${0.000335218 * track_mass_scale}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="-1.5708 0 -3.14159"/>
        <geometry>
          <mesh filename="${body_right_mesh}"/>
        </geometry>
        <material name="${name}_material">
          <color rgba="0.647059 0.647059 0.647059 1"/>
        </material>
      </visual>
      <visual>
        <geometry>
          <mesh filename="${track_belt_right_mesh}"/>
        </geometry>
        <material name="track_belt_material">
          <color rgba="0.13 0.13 0.14 1"/>
        </material>
      </visual>
      <xacro:if value="${body_box and not track_nose}">
        <!-- bounding box of body_right.stl -->
        <collision>
          <origin xyz="-0.025 0.0174 -0.0119" rpy="0 0 0"/>
          <geometry>
            <box size="0.05 0.0869 0.1417"/>
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${not track_nose and not body_box}">
        <collision>
          <origin xyz="0 0 0" rpy="-1.5708 0 -3.14159"/>
          <geometry>
            <mesh filename="${body_right_mesh}"/>
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${track_nose}">
        <!-- IsaacLab nose asset (Legs3+) - track box cut along the belt line + belt_nose prism (meshes/make_track_nose.py) -->
        <collision name="${name}_box">
          <geometry>
            <mesh filename="file://$(find mulinex_description)/meshes//track_box_nose_right.stl"/>
          </geometry>
        </collision>
        <collision name="${name}_belt_nose">
          <geometry>
            <mesh filename="file://$(find mulinex_description)/meshes//track_belt_nose_right.stl"/>
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <xacro:if value="${track_nose}">
      <!-- frictionless, as in IsaacLab (ground_friction frictionless_colliders) - they stand for the driven belt -->
      <gazebo reference="${name}">
        <collision>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </gazebo>
    </xacro:if>
  </xacro:macro>

  <!-- ===================== INSTANZE CORPI & RUOTE ===================== -->

  <!-- LEFT_H -->
  <xacro:body_left name="body_left_H" parent="LH_UPPER_LEG"
                   xyz="-0.19 0.05 0" rpy="1.5708 0 1.5708" ankle_center="${-ankle_flat}"/>
  <xacro:wheel name="wheel_1_LEFT_H" parent="body_left_H" xyz="0 0.0484063 -0.0583795" rpy="-6.12323e-17 -1.5708 0"/>
  <xacro:wheel name="wheel_2_LEFT_H" parent="body_left_H" xyz="0 1.07779e-16 -0.0583795" rpy="-6.12323e-17 -1.5708 0"/>
  <xacro:wheel name="wheel_3_LEFT_H" parent="body_left_H" xyz="0 -0.0510313 -0.0583795" rpy="-6.12323e-17 -1.5708 0"/>
  <xacro:wheel name="wheel_4_LEFT_H" parent="body_left_H" xyz="0 -0.0766777 -0.0417374" rpy="-6.12323e-17 -1.5708 0" rollers="false"/>

  <!-- LEFT_F -->
  <xacro:body_left name="body_left_F" parent="LF_UPPER_LEG"
                   xyz="0.19 0.05 0" rpy="-1.5708 0 1.5708" ankle_center="${ankle_flat}"/>
  <xacro:wheel name="wheel_1_LEFT_F" parent="body_left_F" xyz="0 0.0484063 -0.0583795" rpy="-6.12323e-17 -1.5708 0"/>
  <xacro:wheel name="wheel_2_LEFT_F" parent="body_left_F" xyz="0 1.07779e-16 -0.0583795" rpy="-6.12323e-17 -1.5708 0"/>
  <xacro:wheel name="wheel_3_LEFT_F" parent="body_left_F" xyz="0 -0.0510313 -0.0583795" rpy="-6.12323e-17 -1.5708 0"/>
  <xacro:wheel name="wheel_4_LEFT_F" parent="body_left_F" xyz="0 -0.0766777 -0.0417374" rpy="-6.12323e-17 -1.5708 0" rollers="false"/>

  <!-- RIGHT_F -->
  <xacro:body_right name="body_right_F" parent="RF_UPPER_LEG"
                    xyz="0.19 -0.05 0" rpy="3.14159 0 1.5708" ankle_center="${ankle_flat}"/>
  <xacro:wheel name="wheel_1_RIGHT_F" parent="body_right_F" xyz="2.08167e-17 0.0583795 0.0484062" rpy="-1.5708 0 -1.5708"/>
  <xacro:wheel name="wheel_2_RIGHT_F" parent="body_right_F" xyz="0 0.0583795 1.10544e-16" rpy="-1.5708 0 -1.5708"/>
  <xacro:wheel name="wheel_3_RIGHT_F" parent="body_right_F" xyz="-2.08167e-17 0.0583795 -0.0510312" rpy="-1.5708 0 -1.5708"/>
  <xacro:wheel name="wheel_4_RIGHT_F" parent="body_right_F" xyz="-3.46945e-17 0.0417374 -0.0766777" rpy="-1.5708 0 -1.5708" rollers="false"/>

  <!-- RIGHT_H -->
  <xacro:body_right name="body_right_H" parent="RH_UPPER_LEG"
                    xyz="-0.19 -0.05 0" rpy="0 0 1.5708" ankle_center="${-ankle_flat}"/>
  <xacro:wheel name="wheel_1_RIGHT_H" parent="body_right_H" xyz="2.08167e-17 0.0583795 0.0484062" rpy="-1.5708 0 -1.5708"/>
  <xacro:wheel name="wheel_2_RIGHT_H" parent="body_right_H" xyz="0 0.0583795 1.10544e-16" rpy="-1.5708 0 -1.5708"/>
  <xacro:wheel name="wheel_3_RIGHT_H" parent="body_right_H" xyz="-2.08167e-17 0.0583795 -0.0510312" rpy="-1.5708 0 -1.5708"/>
  <xacro:wheel name="wheel_4_RIGHT_H" parent="body_right_H" xyz="-3.46945e-17 0.0417374 -0.0766777" rpy="-1.5708 0 -1.5708" rollers="false"/>

</robot>
